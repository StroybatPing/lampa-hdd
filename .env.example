# Ключ доступу до мосту. Той самий рядок вписати в Lampa:
# Налаштування → Зберегти на HDD → Ключ доступу.
# Згенерувати: openssl rand -hex 16
LAMPA_TOKEN=

# Де лежать завантаження і медіатека (шляхи на хості)
DOWNLOADS_DIR=/srv/torrents
MEDIA_DIR=/srv/media

# Ключ Jackett — беремо після першого запуску з http://localhost:9117
JACKETT_API_KEY=

# Необовʼязково: автоскан медіатеки після переносу
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=

# Користувач, від якого пишуться файли, і часовий пояс
PUID=1000
PGID=1000
TZ=Europe/Kyiv

# Порти назовні
BRIDGE_PORT=8091
TRANSMISSION_PORT=9091
JACKETT_PORT=9117
TORRSERVER_PORT=8090
