# Віддача плагіна (і, за бажанням, локальної копії збірки Lampa).
# Виправте шляхи під себе. Порт 8095 має бути доступний з телевізора.

:8095 {
	encode gzip

	handle /hdd.js {
		root * /ШЛЯХ/ДО/lampa-hdd/plugin
		file_server
	}

	# Необовʼязково: локальна копія збірки Lampa, щоб відкривати її по http
	# (тоді плагін не впирається в mixed content — див. README).
	handle {
		root * /ШЛЯХ/ДО/копії/lampa
		file_server
	}
}
